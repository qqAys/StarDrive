# Copy this file to .env before starting StarDrive.
# Generate a stable production secret with: openssl rand -hex 32
STARDRIVE_APP_SECRET=replace-with-a-random-secret-before-starting

# Optional application settings
STARDRIVE_APP_DEFAULT_LANGUAGE=en-US
STARDRIVE_APP_INIT_USER=admin@stardrive.abc
STARDRIVE_APP_ALLOW_REGISTRATION=true
STARDRIVE_LOG_LEVEL=INFO
